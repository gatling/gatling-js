{
  "name": "gatling-ts-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "target/bundle",
  "dependencies": {
    "@gatling.io/core": "3.16.101",
    "@gatling.io/graphql": "3.16.101",
    "@gatling.io/grpc": "3.16.101",
    "@gatling.io/http": "3.16.101",
    "@gatling.io/jdbc": "3.16.101",
    "@gatling.io/jms": "3.16.101",
    "@gatling.io/kafka": "3.16.101",
    "@gatling.io/mqtt": "3.16.101",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@gatling.io/cli": "3.16.101",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "clean": "rimraf target",
    "format": "prettier --write '**/*.ts'",
    "setup": "gatling install",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && gatling build --typescript",
    "start": "gatling run",
    "recorder": "gatling recorder --typescript"
  },
  "gatling": {
    "jvmDependencies": {
      "artifacts": ["org.apache.artemis:artemis-jakarta-client:2.57.0", "org.postgresql:postgresql:42.7.14"]
    }
  }
}
